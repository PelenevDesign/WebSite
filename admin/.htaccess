# Админку не встраиваем во фрейм ни себе, ни Метрике: карты кликов ей не
# нужны, а рамка вокруг панели управления — лишний способ подсунуть клик.
# Правило перекрывает белый список из корневого .htaccess.
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "frame-ancestors 'none'"
  Header always set X-Frame-Options "DENY"
  Header always set X-Robots-Tag "noindex, nofollow, noarchive"
</IfModule>
