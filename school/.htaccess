Options -Indexes
DirectoryIndex index.php

# Запасное хранилище видео (если нельзя писать вне public_html) — снаружи недоступно.
RedirectMatch 404 ^/school/_storage(/|$)
<FilesMatch "^(lib\.php|README\.md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive"
</IfModule>
