# Секреты — реальные пароли БД и админки. Остаются только на сервере,
# в репозиторий никогда не попадают. См. config.example.php рядом.
/config.php
/cloud/config.php

# Пользовательские загрузки: фото/видео кейсов, отзывы, медиатека.
