/uploads/

# Служебное состояние рантайма — пересоздаётся сервером сам.
/.htlead-attempts.json
/.htlogin-attempts.json
/install.lock

# Архивы прошлых ручных доставок и экспортов — не часть сайта.
*.zip
/__MACOSX/

# Системное.
.DS_Store
Thumbs.db
